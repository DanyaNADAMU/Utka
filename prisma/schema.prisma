generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  authentikId   String         @unique
  email         String?
  name          String?
  role          String         @default("USER")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id          String      @id @default(uuid())
  token       String      @unique @default(uuid()) // URL token (e.g., /api/sub/<token>)
  name        String?     // E.g., "iPhone"
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String
  node        Node        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  lastFetched DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  traffic     TrafficLog?
  history     TrafficHistory[]
  inbounds    SubscriptionInbound[]
  uuidHistory        UuidHistory[]
  uuidTrafficLogs    UuidTrafficLog[]
  uuidTrafficHistory UuidTrafficHistory[]
}

model SubscriptionInbound {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  inboundTag     String
  xrayUuid       String       @unique @default(uuid())
  
  @@unique([subscriptionId, inboundTag])
}

model TrafficLog {
  id             String       @id @default(uuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  up             BigInt       @default(0)
  down           BigInt       @default(0)
  lastUpdate     DateTime     @default(now())
}

model TrafficHistory {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  up             BigInt
  down           BigInt
  timestamp      DateTime     @default(now())
  isCompressed   Boolean      @default(false)
}

model UuidHistory {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  inboundTag     String
  xrayUuid       String
  createdAt      DateTime     @default(now())
}

model UuidTrafficLog {
  id             String       @id @default(uuid())
  xrayUuid       String       @unique
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  up             BigInt       @default(0)
  down           BigInt       @default(0)
  lastUpdate     DateTime     @default(now())
}

model UuidTrafficHistory {
  id             String       @id @default(uuid())
  xrayUuid       String
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  up             BigInt
  down           BigInt
  timestamp      DateTime     @default(now())
  isCompressed   Boolean      @default(false)
}

model Node {
  id            String         @id @default(uuid())
  name          String
  address       String         // IP or Domain of the node for VLESS config
  port          Int
  apiHost       String         // gRPC API host, e.g., "xray:7999"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model ExpiringUuid {
  id             String       @id @default(uuid())
  subscriptionId String
  xrayUuid       String
  xrayEmail      String       // The email string used in Xray (e.g. subId_xrayUuid)
  inboundTag     String
  nodeId         String       // We need to know which node to remove it from
  expiresAt      DateTime
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
