#!/usr/bin/env node

const path = require('path');
const fs = require('fs');

const utkaPath = path.join(__dirname, 'utkactl.js');
const dashPath = path.join(__dirname, 'dashctl.js');

if (fs.existsSync(utkaPath)) {
  require(utkaPath);
} else if (fs.existsSync(dashPath)) {
  require(dashPath);
} else {
  console.error("utkactl.js not found. Please run 'npm run build:cli' first.");
  process.exit(1);
}
