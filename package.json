{
  "name": "utka",
  "version": "1.2.2",
  "description": "Utka: modular, stealth proxy management suite (utka-core, utka-sub, utka-web, utka-cli)",
  "private": true,
  "bin": {
    "utka": "bin/utka"
  },
  "scripts": {
    "dev": "next dev",
    "build:core": "esbuild src/core.ts --bundle --platform=node --target=node24 --external:@prisma/client --outfile=.next/standalone/core.js",
    "build:worker": "npm run build:core && cp .next/standalone/core.js .next/standalone/worker.js",
    "build:sub": "esbuild src/sub.ts --bundle --platform=node --target=node24 --external:@prisma/client --outfile=.next/standalone/sub.js",
    "build:cli": "esbuild src/cli/utka.ts --bundle --platform=node --target=node24 --external:@prisma/client --outfile=bin/utka.js",
    "build": "next build && npm run build:core && cp .next/standalone/core.js .next/standalone/worker.js && npm run build:sub && npm run build:cli",
    "start": "next start",
    "core": "node .next/standalone/core.js",
    "worker": "node .next/standalone/worker.js",
    "sub": "node .next/standalone/sub.js",
    "cli": "node bin/utka.js",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@prisma/client": "^6.19.3",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "protobufjs": "^8.7.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.14.1",
    "strip-json-comments": "^5.0.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/strip-json-comments": "^0.0.30",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
