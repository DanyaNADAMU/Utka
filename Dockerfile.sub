FROM node:24-alpine AS builder
WORKDIR /app

# Install dependencies needed for compiling sub service
COPY package.json package-lock.json* ./
RUN npm ci

# Generate Prisma client
COPY prisma ./prisma
RUN npx prisma generate

# Copy proto definitions, source code, and tsconfig for path aliases (@/*)
COPY tsconfig.json ./
COPY src/proto ./src/proto
COPY src ./src

# Build standalone sub service bundle with esbuild (independent of Next.js / React)
RUN npx esbuild src/sub.ts --bundle --platform=node --target=node24 --external:@prisma/client --outfile=dist/sub.js

# Production runner image
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 65532 nodejs && \
    adduser --system --uid 65532 nextjs

# Copy Prisma schema and node_modules for Prisma client
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /app/src/proto ./src/proto
COPY --from=builder --chown=nextjs:nodejs /app/dist/sub.js ./sub.js

USER nextjs

EXPOSE 8008

ENV SUB_PORT=8008
ENV SUB_HOST="0.0.0.0"

CMD ["node", "sub.js"]
