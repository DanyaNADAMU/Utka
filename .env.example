# App URL (e.g. http://localhost:3000 or https://dash.domain.com)
AUTH_URL=http://localhost:3000
AUTH_SECRET="generate_via_npx_auth_secret"

# Authentik OIDC Config
AUTHENTIK_CLIENT_ID="your_client_id"
AUTHENTIK_CLIENT_SECRET="your_client_secret"
AUTHENTIK_ISSUER="https://auth.your-domain.com/application/o/provider-name/"

# Database (PostgreSQL)
POSTGRES_USER="nadamu"
POSTGRES_PASSWORD="nadamu_secure_password"
POSTGRES_DB="nadamu_db"
DATABASE_URL="postgresql://nadamu:nadamu_secure_password@postgres:5432/nadamu_db?schema=public"

# Xray Config
XRAY_API_URL="xray:8080"
XRAY_SERVER_DOMAIN="nada.mu"
XRAY_PUBLIC_KEY="your_reality_public_key"
XRAY_SHORT_ID="your_reality_short_id"
XRAY_SNI="biz.mail.ru"
