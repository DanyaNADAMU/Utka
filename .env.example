# App URL (e.g. http://localhost:3000 or https://dash.example.com)
AUTH_URL=http://localhost:3000
AUTH_SECRET="generate_via_npx_auth_secret"

# Authentik OIDC Config
AUTHENTIK_CLIENT_ID="your_client_id"
AUTHENTIK_CLIENT_SECRET="your_client_secret"
AUTHENTIK_ISSUER="https://auth.example.com/application/o/provider-name/"

# Database (PostgreSQL)
POSTGRES_USER="utka"
POSTGRES_PASSWORD="db_password_here"
POSTGRES_DB="utka_db"
DATABASE_URL="postgresql://utka:db_password_here@postgres:5432/utka_db?schema=public"

# Xray Master Node Config
# Domain or IP address of the primary Xray ingress server
XRAY_SERVER_DOMAIN_OR_IP="vpn.example.com"
XRAY_API_URL="unix:///app/xray/api.sock"

# Optional Branding & Relay Overrides
BRAND_NAME="Utka"
BASE_DOMAIN="https://vpn.example.com"
