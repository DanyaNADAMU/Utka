# App URL (e.g. http://localhost:3000 or https://dash.example.com)
AUTH_URL=http://localhost:3000
AUTH_SECRET="generate_via_npx_auth_secret"

# Authentik OIDC Config
AUTHENTIK_CLIENT_ID="your_client_id"
AUTHENTIK_CLIENT_SECRET="your_client_secret"
AUTHENTIK_ISSUER="https://auth.example.com/application/o/provider-name/"

# Database (PostgreSQL)
POSTGRES_USER="nadamu"
POSTGRES_PASSWORD="db_password_here"
POSTGRES_DB="nadamu_db"
DATABASE_URL="postgresql://nadamu:db_password_here@postgres:5432/nadamu_db?schema=public"

# Xray Config
# Put IP address (e.g. 81.30.105.65) or Domain (e.g. nada.mu) here
XRAY_SERVER_DOMAIN_OR_IP="81.30.105.65"
